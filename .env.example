# Koneksi PostgreSQL (lokal / Docker / Supabase — gunakan connection string Postgres)
DATABASE_URL="postgresql://hakuu:hakuu@localhost:5432/hakuu_bakery?schema=public"

# Rahasia untuk menandatangani sesi admin & akses pesanan customer (min. 32 karakter acak)
# Buat dengan: openssl rand -hex 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL proyek Storage dan service role (hanya di server; jangan gunakan NEXT_PUBLIC_)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Akun admin pertama (dipakai oleh `npm run db:seed`, ganti password setelah login)
ADMIN_EMAIL="admin@hakuubakery.com"
ADMIN_PASSWORD="ganti-password-kuat"

# Opsional: perbesar batas rate-limit (hanya untuk test otomatis)
# RATE_LIMIT_MULTIPLIER=1
